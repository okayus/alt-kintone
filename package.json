{
  "name": "alt-kintone",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "verify": "pnpm check:wiring && pnpm lint && pnpm typecheck && pnpm test",
    "alt": "tsx --tsconfig packages/cli/tsconfig.json packages/cli/src/main.ts",
    "serve": "tsx --tsconfig packages/server/tsconfig.json packages/server/src/main.ts",
    "dev": "pnpm --filter @alt/main dev",
    "check:wiring": "node scripts/check-wiring.mjs",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome ci .",
    "fmt": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "^24.13.0",
    "tsx": "4.19.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
