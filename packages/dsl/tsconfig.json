{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // tsc は --noEmit の typecheck 専用で、実ビルドと型出力は tsdown
    // (`vp pack --dts`) が dist に対して行う。packages/sql と設定を揃えている。
    //
    // なお `vp pack --dts` は型生成の副産物として src/index.d.ts を残す
    // （tsconfig 側では抑止できなかった）。生成物なので .gitignore で除外している。
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*"],
  "exclude": ["dist"]
}
