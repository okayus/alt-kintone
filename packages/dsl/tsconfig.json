{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // tsc は typecheck 専用。このパッケージは dist を作らない（package.json に
    // main / exports が無い）ので、参照はすべて paths と resolve.alias が
    // src/index.ts を直接指す。packages/sql と設定を揃えている。
    "noEmit": true,
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src/**/*"],
  "exclude": ["dist"]
}
