{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // packages/sql と同じ理由（下の paths が rootDir の外を指すため TS6059 が出る）。
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      // prebuild なしで typecheck できるようソースを直接指す。
      // 依存はこれだけ。定義そのものは SQL 層にも CLI にも依存しない
      // （定義が SQL に変換できるかは `alt validate` 側で検証している）
      "@alt/dsl": ["../../packages/dsl/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist"]
}
