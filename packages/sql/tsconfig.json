{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // tsc は typecheck 専用（dist は作らない）。下の paths が rootDir の外
    // （packages/dsl/src）を指すため、rootDir/outDir と併用すると TS6059 が出る。
    // noEmit / declaration:false で回避する。
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      // prebuild なしで typecheck できるようソースを直接指す。同じ解決を
      // 実行時に与えるのが vitest.shared.ts の resolve.alias。
      "@alt/dsl": ["../../packages/dsl/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist"]
}
