{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // packages/sql と同じ理由（下の paths が rootDir の外を指すため TS6059 が出る）。
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      // prebuild なしで typecheck できるようソースを直接指す。
      // この paths は `alt` の**実行時**にも効く。ルート package.json の起動コマンドが
      // `tsx --tsconfig packages/cli/tsconfig.json` を渡しているため（--tsconfig が無いと
      // tsx は workspace シンボリックリンク経由で dist/ の古い成果物を読む）。
      "@alt/definitions": ["../../packages/definitions/src/index.ts"],
      "@alt/diff": ["../../packages/diff/src/index.ts"],
      "@alt/dsl": ["../../packages/dsl/src/index.ts"],
      "@alt/sql": ["../../packages/sql/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist"]
}
