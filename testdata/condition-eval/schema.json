{
  "employee": {
    "name": "employee",
    "label": "従業員",
    "global": true,
    "fields": {
      "id": { "type": "uuid", "label": "ID", "required": true, "primaryKey": true },
      "name": { "type": "text", "label": "氏名", "required": true, "primaryKey": false }
    }
  },
  "company": {
    "name": "company",
    "label": "顧客企業",
    "global": false,
    "fields": {
      "id": { "type": "uuid", "label": "ID", "required": true, "primaryKey": true },
      "name": { "type": "text", "label": "名称", "required": true, "primaryKey": false }
    }
  },
  "contact": {
    "name": "contact",
    "label": "先方担当者",
    "global": false,
    "fields": {
      "id": { "type": "uuid", "label": "ID", "required": true, "primaryKey": true },
      "companyId": { "type": "uuid", "label": "顧客企業", "required": true, "primaryKey": false, "references": "company" },
      "isDecisionMaker": { "type": "boolean", "label": "決裁権", "required": true, "primaryKey": false }
    }
  },
  "deal": {
    "name": "deal",
    "label": "案件",
    "global": false,
    "fields": {
      "id": { "type": "uuid", "label": "ID", "required": true, "primaryKey": true },
      "companyId": { "type": "uuid", "label": "顧客企業", "required": true, "primaryKey": false, "references": "company" },
      "initialBilling": { "type": "integer", "label": "一時金・請求額", "required": false, "primaryKey": false },
      "monthlyBilling": { "type": "integer", "label": "月額・請求額", "required": false, "primaryKey": false },
      "expectedCloseMonth": { "type": "yearMonth", "label": "見込み受注月", "required": false, "primaryKey": false },
      "status": {
        "type": "enum",
        "label": "状態",
        "required": true,
        "primaryKey": false,
        "values": [
          { "key": "open", "label": "進行中" },
          { "key": "suspended", "label": "保留" },
          { "key": "won", "label": "受注" },
          { "key": "lost", "label": "失注" },
          { "key": "abandoned", "label": "消滅" }
        ]
      },
      "ownerEmployeeId": { "type": "uuid", "label": "担当", "required": true, "primaryKey": false, "references": "employee" }
    }
  },
  "activity": {
    "name": "activity",
    "label": "活動",
    "global": false,
    "fields": {
      "id": { "type": "uuid", "label": "ID", "required": true, "primaryKey": true },
      "dealId": { "type": "uuid", "label": "案件", "required": false, "primaryKey": false, "references": "deal" },
      "contactId": { "type": "uuid", "label": "先方担当者", "required": false, "primaryKey": false, "references": "contact" },
      "scheduledAt": { "type": "datetime", "label": "予定日時", "required": false, "primaryKey": false },
      "completedAt": { "type": "datetime", "label": "実施日時", "required": false, "primaryKey": false }
    }
  }
}
