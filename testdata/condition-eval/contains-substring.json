{
  "case": "案件名に「看板」を含む（部分一致）",
  "note": "value はパターンではなく探す文字列。d4 のワイルドカード（%）が素の文字として扱われること、NULL が真にも偽にもならないこと（d5）が移植で事故りやすい点",
  "root": "deal",
  "ast": {
    "type": "contains",
    "operand": { "type": "field", "source": "root", "path": ["title"] },
    "value": "看板"
  },
  "fixtures": {
    "company": [{ "id": "c1", "name": "山田食堂" }],
    "employee": [{ "id": "e1", "name": "山田" }],
    "deal": [
      {
        "id": "d1",
        "companyId": "c1",
        "title": "山田食堂 看板リニューアル",
        "status": "open",
        "ownerEmployeeId": "e1"
      },
      { "id": "d2", "companyId": "c1", "title": "看板", "status": "open", "ownerEmployeeId": "e1" },
      {
        "id": "d3",
        "companyId": "c1",
        "title": "ホールスタッフ求人",
        "status": "open",
        "ownerEmployeeId": "e1"
      },
      {
        "id": "d4",
        "companyId": "c1",
        "title": "%看%板%",
        "status": "open",
        "ownerEmployeeId": "e1"
      },
      { "id": "d5", "companyId": "c1", "status": "open", "ownerEmployeeId": "e1" }
    ]
  },
  "expected": { "d1": true, "d2": true, "d3": false, "d4": false, "d5": null }
}
