{
  "case": "NULL との比較は真でも偽でもない（SQL の三値論理）",
  "note": "移植で最も事故りやすい箇所（docs/condition-ast.md §8）。TS で素朴に実装すると false になるが、SQL では UNKNOWN。d2 の期待値が null であることが要点",
  "root": "deal",
  "ast": {
    "type": "compare",
    "op": "gt",
    "left": { "type": "field", "source": "root", "path": ["initialBilling"] },
    "right": { "type": "literal", "value": 0 }
  },
  "fixtures": {
    "company": [{ "id": "c1", "name": "山田食堂" }],
    "employee": [{ "id": "e1", "name": "山田" }],
    "deal": [
      { "id": "d1", "companyId": "c1", "status": "open", "ownerEmployeeId": "e1", "initialBilling": 100 },
      { "id": "d2", "companyId": "c1", "status": "open", "ownerEmployeeId": "e1", "initialBilling": null },
      { "id": "d3", "companyId": "c1", "status": "open", "ownerEmployeeId": "e1", "initialBilling": 0 }
    ]
  },
  "expected": { "d1": true, "d2": null, "d3": false }
}
