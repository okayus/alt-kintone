{
"permissions": {
  "allow": [
    "Bash(docker compose exec dev pnpm *)",
    "Bash(docker compose exec -d dev pnpm *)",
    "Bash(docker compose ps *)"
  ]
},
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pnpm-install-on-manifest-change.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
